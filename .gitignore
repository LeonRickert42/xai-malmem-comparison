# ============================================================
#  FW1 Experiment — .gitignore
# ============================================================

# ── Datenverzeichnis ─────────────────────────────────────────
# Rohdaten werden nicht mit versioniert (Herkunft / Größe / Lizenz).
# Nur die README bleibt drin.
data/*
!data/README.md
!data/.gitkeep

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
.env

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Run logs (verbose stdout dumps not part of the result) ───
results/*.log
results/last_run.log

# ── Build / Distribution ─────────────────────────────────────
build/
dist/
*.egg-info/

# ── macOS ────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
